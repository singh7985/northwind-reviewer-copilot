# --- LLM ---
# If empty, the system runs in DETERMINISTIC-ONLY mode (no extraction LLM, no
# adjudication LLM, no embeddings). The eval harness and rule engine still work;
# only LLM-dependent verdicts fall back to "needs_human_review".
OPENAI_API_KEY=

OPENAI_EXTRACTION_MODEL=gpt-4o-mini
OPENAI_ADJUDICATION_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_QA_MODEL=gpt-4o-mini

# --- Database ---
DATABASE_URL=postgresql+psycopg://northwind:northwind@localhost:5432/northwind

# --- Server ---
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:3000

# --- Storage ---
UPLOAD_DIR=./backend/uploads

# --- Paths ---
POLICY_DIR=./policies
SUBMISSIONS_DIR=./submissions
EMPLOYEES_SEED=./data/employees.json
